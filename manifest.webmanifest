{
  "name": "KvizOpoly z delfinom Kviškom",
  "short_name": "KvizOpoly",
  "description": "Učna PWA za iPhone in Safari z uvozom kvizov, Notebookov in pametnim ponavljanjem.",
  "lang": "sl",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0b1024",
  "theme_color": "#11152b",
  "categories": [
    "education",
    "games"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",

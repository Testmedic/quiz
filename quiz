function editQ(id){
  var quiz=S.quizzes.find(function(q){return q.id===id;});if(!quiz)return;
  document.getElementById('qname').value=quiz.name;document.getElementById('qcat').value=quiz.category;
  var s=quiz.settings||{};
  document.getElementById('ict').value=s.correctTime||2;document.getElementById('iwt').value=s.wrongTime||5;
  document.getElementById('isq').value=s.shuffleQ?'1':'0';document.getElementById('isa').value=s.shuffleA?'1':'0';
  var txt='';
  for(var i=0;i<quiz.questions.length;i++){var q=quiz.questions[i];if(i>0)txt+='\n\n';txt+=q.q+'\n';for(var j=0;j<q.opts.length;j++)txt+=(j+1)+'. '+q.opts[j]+(j===q.ans?' (P)':'')+'\n';if(q.exp)txt+='// '+q.exp;}
  document.getElementById('impta').value=txt.trim();parsed=quiz.questions.slice();showPreview(parsed);
  S.quizzes=S.quizzes.filter(function(q){return q.id!==id;});saveS();
  goTo('s-import');toast('✏️ Kviz naložen za urejanje.');
}

function startQuiz(quiz){
  curQuiz=quiz;var s=quiz.settings||{};
  var qs=quiz.questions.slice();
  if(s.shuffleQ!==false)qs=shuffle(qs);
  curQs=qs;qi=0;qc=0;qw=0;qans=false;qwrong=[];qCoins=0;
  if(qtimer)clearTimeout(qtimer);
  goTo('s-quiz');
  showQ();
}

function showQ(){
  if(qi>=curQs.length){showEnd();return;}
  qans=false;if(qtimer)clearTimeout(qtimer);
  var q=curQs[qi];var s=curQuiz.settings||{};
  document.getElementById('q-badge').textContent=curQuiz.name;
  document.getElementById('q-num').textContent=(qi+1)+'/'+curQs.length;
  document.getElementById('q-cat-badge').textContent='📚 '+curQuiz.category;
  document.getElementById('qtext').textContent=q.q;
  document.getElementById('q-xp').textContent=qc*10;
  document.getElementById('q-coins').textContent=qCoins;
  var pct=(qi/curQs.length)*100;
  document.getElementById('q-prog').style.width=pct+'%';

  var idxs=[];for(var i=0;i<q.opts.length;i++)idxs.push(i);
  if(s.shuffleA!==false)idxs=shuffle(idxs);
  var correctOrig=q.ans;

  var od=document.getElementById('qopts');od.innerHTML='';
  for(var di=0;di<idxs.length;di++){
    (function(dIdx,oIdx){
      var btn=document.createElement('button');
      btn.className='ans-btn';
      var ltr=document.createElement('span');ltr.className='altr';ltr.textContent=String.fromCharCode(65+dIdx);
      btn.appendChild(ltr);btn.appendChild(document.createTextNode(q.opts[oIdx]));
      btn.onclick=function(){pickA(oIdx===correctOrig,btn,od,q,correctOrig);};
      od.appendChild(btn);
    })(di,idxs[di]);
  }

  var fb=document.getElementById('qfb');fb.style.display='none';fb.textContent='';
  document.getElementById('qtw').style.display='none';
  updateQScore();
}

function pickA(isOk,btn,od,q,correctOrig){
  if(qans)return;qans=true;
  var allBtns=od.querySelectorAll('.ans-btn');
  for(var i=0;i<allBtns.length;i++){allBtns[i].disabled=true;allBtns[i].classList.add('dim');}
  if(!isOk){
    btn.classList.remove('dim');btn.classList.add('wrong');
    qw++;qwrong.push(q);
    document.getElementById('qcard').classList.add('shake');
    setTimeout(function(){document.getElementById('qcard').classList.remove('shake');},350);
  } else {
    btn.classList.remove('dim');btn.classList.add('correct');
    qc++;
    var coinsEarned=Math.floor(Math.random()*3)+3; // 3-5 coins per correct
    qCoins+=coinsEarned;
    document.getElementById('qcard').classList.add('glow');
    setTimeout(function(){document.getElementById('qcard').classList.remove('glow');},400);
    // XP burst animation
    xpBurst(btn,'+'+coinsEarned+'🪙');
  }
  // Mark correct
  var ct=q.opts[correctOrig];
  for(var i=0;i<allBtns.length;i++){
    var bt=allBtns[i].textContent.replace(/^[A-Z]/,'').trim();
    if(bt===ct){allBtns[i].classList.remove('dim');allBtns[i].classList.add('correct');break;}
  }
  var s=curQuiz.settings||{};
  var fb=document.getElementById('qfb');
  fb.style.display='block';
  fb.style.background=isOk?'var(--green-bg)':'var(--red-bg)';
  fb.style.border='1.5px solid '+(isOk?'rgba(52,199,89,.3)':'rgba(255,59,48,.3)');
  fb.style.color=isOk?'#1a5c2a':'#7a1a1a';
  var msg=isOk?'✅ Pravilno!':'❌ Napačno. Pravilen odgovor: '+ct;
  if(q.exp)msg+='\n💡 '+q.exp;
  fb.textContent=msg;
  updateQScore();
  var tw=document.getElementById('qtw'),tb=document.getElementById('qtb');
  tw.style.display='block';tb.className='tbar '+(isOk?'ok':'no');
  var delay=(isOk?(s.correctTime||2):(s.wrongTime||5))*1000;
  tb.style.transition='none';tb.style.width='100%';
  setTimeout(function(){tb.style.transition='width '+delay+'ms linear';tb.style.width='0%';},60);
  qtimer=setTimeout(function(){qi++;showQ();},delay);
}

function updateQScore(){
  var total=qc+qw;
  document.getElementById('q-sc').textContent=qc;
  document.getElementById('q-sw').textContent=qw;
  document.getElementById('q-pct').textContent=total>0?Math.round(qc/total*100)+'%':'–';
  document.getElementById('q-xp').textContent=qc*10;
  document.getElementById('q-coins').textContent=qCoins;
}

function showEnd(){
  if(qtimer)clearTimeout(qtimer);
  var total=qc+qw;
  var pct=total>0?Math.round(qc/total*100):0;
  var xpEarned=qc*10;
  var coinsEarned=qCoins;

  // Update streak
  var today=new Date().toDateString();
  if(S.lastPlay!==today){
    var yesterday=new Date(Date.now()-86400000).toDateString();
    if(S.lastPlay===yesterday){S.streak++;}
    else if(S.lastPlay!==today){S.streak=1;}
    S.lastPlay=today;
  }

  S.xp+=xpEarned;
  S.coins+=coinsEarned;
  S.totalPlayed++;
  if(curQuiz&&curQuiz.id&&pct>(S.bestScores[curQuiz.id]||0))S.bestScores[curQuiz.id]=pct;
  saveS();

  document.getElementById('e-pct').textContent=pct+'%';
  document.getElementById('e-c').textContent=qc;
  document.getElementById('e-w').textContent=qw;
  document.getElementById('e-xp').textContent='+'+xpEarned;
  document.getElementById('e-coins').textContent='+'+coinsEarned;

  var emoji,msg;
  if(pct>=90){emoji='🏆';msg='Odlično! Mojster si!';}
  else if(pct>=75){emoji='🎯';msg='Zelo dobro! Še malo vaje!';}
  else if(pct>=60){emoji='📚';msg='Dobro! Nadaljuj z učenjem!';}
  else if(pct>=40){emoji='💪';msg='Ponovi napačne odgovore!';}
  else{emoji='🔄';msg='Začni znova – zmoreš!';}
  document.getElementById('e-emoji').textContent=emoji;
  document.getElementById('e-msg').textContent=msg;

  // Reward
  var rw=document.getElementById('e-reward');
  var rwt=document.getElementById('e-reward-text');
  var cheapProp=PROPS.find(function(p){return !S.properties[p.id]&&S.coins>=p.price;});
  if(cheapProp){
    rw.style.display='block';
    rwt.textContent='Imaš dovolj kovancev za '+cheapProp.emoji+' '+cheapProp.name+'! Pojdi na Mapo in jo kupi.';
  } else {
    rw.style.display='none';
  }

  goTo('s-end');
  if(pct>=80)confetti();
}

function restartQuiz(){if(curQuiz)startQuiz(curQuiz);}
function restartWrong(){
  if(qwrong.length===0){toast('🎉 Ni napačnih!');return;}
  var tmp={};for(var k in curQuiz)tmp[k]=curQuiz[k];
  tmp.questions=qwrong;startQuiz(tmp);
}

// ═══════════════════════════════════════════════════════
// MODAL
// ═══════════════════════════════════════════════════════
function showModal(html){
  document.getElementById('msheet-content').innerHTML=html;
  document.getElementById('moverlay').classList.add('on');
}
function closeModal(){document.getElementById('moverlay').classList.remove('on');}
document.getElementById('moverlay').addEventListener('click',function(e){if(e.target===document.getElementById('moverlay'))closeModal();});

function confirmDel(id){
  var quiz=S.quizzes.find(function(q){return q.id===id;});
  showModal('<div class="mhandle"></div><h3 style="font-size:1.1rem;font-weight:800;margin-bottom:8px">🗑️ Izbriši kviz</h3><p style="color:var(--ink3);font-size:.86rem;margin-bottom:16px">Ali res želiš izbrisati "'+esc(quiz?quiz.name:'')+'"?</p><div style="display:flex;gap:9px"><button class="btn btn-md btn-ghost" style="flex:1" onclick="closeModal()">Prekliči</button><button class="btn btn-md btn-red" style="flex:1" onclick="delQ('+id+')">Izbriši</button></div>');
}
function delQ(id){S.quizzes=S.quizzes.filter(function(q){return q.id!==id;});saveS();closeModal();renderQL();toast('🗑️ Kviz izbrisan!');}

function confirmQuit(){
  if(qtimer)clearTimeout(qtimer);
  showModal('<div class="mhandle"></div><h3 style="font-size:1.1rem;font-weight:800;margin-bottom:8px">✕ Zapri kviz</h3><p style="color:var(--ink3);font-size:.86rem;margin-bottom:16px">Napredek bo izgubljen.</p><div style="display:flex;gap:9px"><button class="btn btn-md btn-ghost" style="flex:1" onclick="closeModal()">Nadaljuj</button><button class="btn btn-md btn-red" style="flex:1" onclick="closeModal();goTo(\'s-quiz-list\')">Zapri</button></div>');
}

// ═══════════════════════════════════════════════════════
// TOAST
// ═══════════════════════════════════════════════════════
var toastT=null;
function toast(msg){
  var el=document.getElementById('toast');el.textContent=msg;el.classList.add('show');
  if(toastT)clearTimeout(toastT);
  toastT=setTimeout(function(){el.classList.remove('show');},2800);
}

// ═══════════════════════════════════════════════════════
// XP BURST ANIMATION
// ═══════════════════════════════════════════════════════
function xpBurst(el,text){
  var rect=el.getBoundingClientRect();
  var div=document.createElement('div');
  div.className='xpburst';div.textContent=text;
  div.style.left=(rect.left+rect.width/2-20)+'px';
  div.style.top=(rect.top-10)+'px';
  document.body.appendChild(div);
  setTimeout(function(){if(div.parentNode)div.parentNode.removeChild(div);},900);
}

// ═══════════════════════════════════════════════════════
// CONFETTI
// ═══════════════════════════════════════════════════════
var CONF_COLORS=['#007AFF','#34C759','#FF9500','#FF2D55','#AF52DE','#FFD60A','#5AC8FA'];
function confetti(){
  for(var i=0;i<40;i++){
    (function(i){
      setTimeout(function(){
        var el=document.createElement('div');
        el.className='conf';
        el.style.left=Math.random()*100+'vw';
        el.style.top='-10px';
        el.style.background=CONF_COLORS[Math.floor(Math.random()*CONF_COLORS.length)];
        el.style.animationDuration=(1.5+Math.random()*1.5)+'s';
        el.style.animationDelay='0s';
        el.style.transform='rotate('+Math.random()*360+'deg)';
        document.body.appendChild(el);
        setTimeout(function(){if(el.parentNode)el.parentNode.removeChild(el);},3500);
      },i*40);
    })(i);
  }
}

// ═══════════════════════════════════════════════════════
// UTILS
// ═══════════════════════════════════════════════════════
function shuffle(arr){var a=arr.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

// ═══════════════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════════════
loadS();
renderHome();
</script>

  {id:'p16',name:'Ventnor',color:'#FFD700',price:260,rent:[22,110,330,800,975],upgrade:150,group:'yellow',emoji:'🌇'},
  {id:'p17',name:'Marvin',color:'#FFD700',price:280,rent:[24,120,360,850,1025],upgrade:150,group:'yellow',emoji:'🌆'},
  {id:'p18',name:'Pacific',color:'#228B22',price:300,rent:[26,130,390,900,1100],upgrade:200,group:'green',emoji:'🌿'},
  {id:'p19',name:'North Carolina',color:'#228B22',price:300,rent:[26,130,390,900,1100],upgrade:200,group:'green',emoji:'🌲'},
  {id:'p20',name:'Pennsylvania',color:'#228B22',price:320,rent:[28,150,450,1000,1200],upgrade:200,group:'green',emoji:'🌳'},
  {id:'p21',name:'Park Place',color:'#00008B',price:350,rent:[35,175,500,1100,1300],upgrade:200,group:'blue',emoji:'🏟️'},
  {id:'p22',name:'Boardwalk',color:'#00008B',price:400,rent:[50,200,600,1400,1700],upgrade:200,group:'blue',emoji:'🎡'},
];

var AVATARS = ['😎','🦊','🐯','🦁','🐸','🦄','🐙','🦋','🐺','🦅'];

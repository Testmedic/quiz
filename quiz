// ═══════════════════════════════════════════════════════
// STORAGE
// ═══════════════════════════════════════════════════════
function loadS(){
  try{var d=JSON.parse(localStorage.getItem('kvo_s')||'{}');
    if(d.quizzes)S.quizzes=d.quizzes;
    if(d.xp)S.xp=d.xp;
    if(d.coins)S.coins=d.coins;
    if(d.streak)S.streak=d.streak;
    if(d.lastPlay)S.lastPlay=d.lastPlay;
    if(d.properties)S.properties=d.properties;
    if(d.totalPlayed)S.totalPlayed=d.totalPlayed;
    if(d.bestScores)S.bestScores=d.bestScores;
  }catch(e){}
}
function saveS(){try{localStorage.setItem('kvo_s',JSON.stringify(S));}catch(e){}}

// ═══════════════════════════════════════════════════════
// NAVIGATION
// ═══════════════════════════════════════════════════════
function goTo(id){
  document.querySelectorAll('.screen').forEach(function(s){s.classList.remove('on');});
  document.getElementById(id).classList.add('on');
  // Update bottom nav
  var map={'s-home':'s-home','s-map':'s-map','s-quiz-list':'s-quiz-list','s-lb':'s-lb','s-import':'s-import'};
  document.querySelectorAll('.bni').forEach(function(b){b.classList.remove('on');});
  if(id==='s-home')document.querySelectorAll('.bni')[0].classList.add('on');
  if(id==='s-map')document.querySelectorAll('.bni')[1].classList.add('on');
  if(id==='s-quiz-list')document.querySelectorAll('.bni')[2].classList.add('on');
  if(id==='s-lb')document.querySelectorAll('.bni')[3].classList.add('on');
  if(id==='s-import')document.querySelectorAll('.bni')[4].classList.add('on');
  window.scrollTo(0,0);
  if(id==='s-home')renderHome();
  if(id==='s-map')renderMap();
  if(id==='s-quiz-list')renderQL();
  if(id==='s-lb')renderLB();
}

// ═══════════════════════════════════════════════════════
// HOME
// ═══════════════════════════════════════════════════════
function renderHome(){
  document.getElementById('h-xp').textContent=S.xp;
  document.getElementById('h-streak').textContent=S.streak;
  document.getElementById('st-quizzes').textContent=S.quizzes.length;
  document.getElementById('st-coins').textContent=S.coins;
  var ownedCount=Object.keys(S.properties).filter(function(k){return S.properties[k]&&S.properties[k].owner==='me';}).length;
  document.getElementById('st-props').textContent=ownedCount;

  // Daily banner
  if(S.quizzes.length>0){
    var last=S.quizzes[S.quizzes.length-1];
    document.getElementById('daily-title').textContent=last.name;
    document.getElementById('daily-sub').textContent=last.questions.length+' vprašanj · '+last.category;
  }

  // Achievements
  if(S.quizzes.length>=1)document.getElementById('ach-0').style.opacity='1';
  if(S.xp>=500)document.getElementById('ach-1').style.opacity='1';
  if(S.streak>=7)document.getElementById('ach-2').style.opacity='1';
  if(ownedCount>=1)document.getElementById('ach-3').style.opacity='1';

  // Properties preview
  var hp=document.getElementById('home-props');
  var owned=PROPS.filter(function(p){return S.properties[p.id]&&S.properties[p.id].owner==='me';});
  if(owned.length===0){
    hp.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:20px;color:var(--ink3);font-size:.84rem">Še nimaš posesti.<br>Zasluži kovance in kupi!</div>';
  } else {
    hp.innerHTML=owned.slice(0,4).map(function(p){
      var lvl=S.properties[p.id]?S.properties[p.id].level:0;
      return '<div class="prop-card" onclick="showPropDetail(\''+p.id+'\')">'
        +'<div class="prop-top" style="background:'+p.color+'"></div>'
        +'<div class="prop-body">'
        +'<div class="prop-name">'+p.emoji+' '+p.name+'</div>'
        +'<div class="prop-price">Nivo '+lvl+' · '+p.rent[lvl]+'🪙/igra</div>'
        +'<div class="prop-level">'+[0,1,2,3,4].map(function(i){return '<span class="'+(i<lvl?'filled':'')+'"></span>';}).join('')+'</div>'
        +'</div></div>';
    }).join('');
  }

  // Recent quizzes
  var hq=document.getElementById('home-quizzes');
  if(S.quizzes.length===0){
    hq.innerHTML='<div style="text-align:center;padding:24px;color:var(--ink3);font-size:.84rem">Še nimaš kvizov.<br>Klikni <strong>Nov</strong> in začni!</div>';
    return;
  }
  hq.innerHTML=S.quizzes.slice(-3).reverse().map(function(q,i){

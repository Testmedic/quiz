// ═══════════════════════════════════════════════════════
// PARSER
// ═══════════════════════════════════════════════════════
function isExp(l){return /^\s*\/\//.test(l)||/^\s*Razlaga:/i.test(l)||/^\s*Explanation:/i.test(l);}
function hasMarker(lines){for(var i=0;i<lines.length;i++){if(/\(P\)|\[P\]/i.test(lines[i])||/\*\s*$/.test(lines[i]))return true;}return false;}
function extractOpts(lines){
  var opts=[],ans=0,exp='';
  for(var i=0;i<lines.length;i++){
    var l=lines[i].trim();if(!l)continue;
    if(isExp(l)){exp=l.replace(/^\s*\/\/\s*/,'').replace(/^\s*Razlaga:\s*/i,'').replace(/^\s*Explanation:\s*/i,'').trim();continue;}
    var c=l.replace(/^[\d]+[.)]\s+/,'').replace(/^[a-zA-Z][.)]\s+/,'').trim();
    var ok=/\(P\)|\[P\]/i.test(c)||/\*\s*$/.test(c)||/^[✓✔]/.test(c);
    c=c.replace(/\s*\(P\)\s*$/i,'').replace(/\s*\[P\]\s*$/i,'').replace(/\s*\*\s*$/,'').replace(/^[✓✔]\s*/,'').trim();
    if(c){if(ok)ans=opts.length;opts.push(c);}
  }
  return{opts:opts,ans:ans,exp:exp};
}
function parseText(raw){
  var qs=[];
  raw=raw.replace(/\r\n/g,'\n').replace(/\r/g,'\n').trim();
  if(!raw)return qs;
  // Pipe
  if(raw.indexOf('|')!==-1&&raw.indexOf('\n\n')===-1){
    var lines=raw.split('\n');var pqs=[];
    for(var i=0;i<lines.length;i++){var l=lines[i].trim();if(!l)continue;
      var parts=l.split('|').map(function(p){return p.trim();}).filter(function(p){return p;});
      if(parts.length<3)continue;var q=parts[0],opts=[],ans=0;
      for(var j=1;j<parts.length;j++){var o=parts[j];if(o.charAt(0)==='*'){ans=opts.length;o=o.slice(1).trim();}if(o)opts.push(o);}
      if(opts.length>=2)pqs.push({q:q,opts:opts,ans:ans,exp:''});}
    if(pqs.length>0)return pqs;
  }
  // CSV
  if(raw.indexOf(',')!==-1&&raw.indexOf('\n\n')===-1){
    var lines=raw.split('\n').filter(function(l){return l.trim();});var cqs=[],ok=true;
    for(var i=0;i<lines.length;i++){var parts=lines[i].split(',').map(function(p){return p.trim();}).filter(function(p){return p;});
      if(parts.length<3){ok=false;break;}var q=parts[0],opts=[],ans=0;
      for(var j=1;j<parts.length;j++){var o=parts[j];if(o.charAt(0)==='*'){ans=opts.length;o=o.slice(1).trim();}if(o)opts.push(o);}
      if(opts.length>=2)cqs.push({q:q,opts:opts,ans:ans,exp:''});}
    if(ok&&cqs.length>0)return cqs;
  }
  // Blocks
  var blocks=raw.split(/\n[ \t]*\n/).map(function(b){return b.trim();}).filter(function(b){return b;});
  var i=0;
  while(i<blocks.length){
    var lines=blocks[i].split('\n').map(function(l){return l.trim();}).filter(function(l){return l;});
    if(!lines.length){i++;continue;}
    var nonExp=lines.filter(function(l){return !isExp(l);});
    if(nonExp.length===1&&!hasMarker(lines)&&i+1<blocks.length){
      var qline=nonExp[0];
      var nextLines=blocks[i+1].split('\n').map(function(l){return l.trim();}).filter(function(l){return l;});
      var r=extractOpts(nextLines);
      if(r.opts.length>=2){qs.push({q:qline,opts:r.opts,ans:r.ans,exp:r.exp});i+=2;continue;}
    }
    if(lines.length>=2){var r=extractOpts(lines.slice(1));if(r.opts.length>=2)qs.push({q:lines[0],opts:r.opts,ans:r.ans,exp:r.exp});}
    i++;
  }
  return qs;
}


<!DOCTYPE html>
<html lang="sl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>KvizOpoly</title>
<style>
/* ─── RESET & BASE ─────────────────────────────────── */
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#F7F3EE;color:#1C1C1E;user-select:none}

/* ─── SCREENS ──────────────────────────────────────── */
.screen{position:fixed;inset:0;display:none;flex-direction:column;overflow:hidden}
.screen.on{display:flex}

/* ─── COLORS ───────────────────────────────────────── */
:root{
  --ink:#1C1C1E;--ink2:#48484A;--ink3:#8E8E93;
  --paper:#F7F3EE;--white:#FFFFFF;
  --line:#E5E0D8;
  --blue:#007AFF;--blue-bg:#EBF4FF;
  --green:#34C759;--green-bg:#E8F8ED;
  --red:#FF3B30;--red-bg:#FFF0EF;
  --orange:#FF9500;--orange-bg:#FFF4E5;
  --purple:#AF52DE;--purple-bg:#F5EEFF;
  --yellow:#FFD60A;--yellow-bg:#FFFBE5;
  --teal:#5AC8FA;--teal-bg:#EAF8FF;
  --pink:#FF2D55;--pink-bg:#FFF0F3;
  --r:16px;--r2:12px;--r3:8px;
  --sh:0 1px 3px rgba(0,0,0,.08),0 4px 12px rgba(0,0,0,.06);
  --sh2:0 2px 8px rgba(0,0,0,.1),0 8px 24px rgba(0,0,0,.08);
}

/* ─── TYPOGRAPHY ───────────────────────────────────── */
.t-hero{font-size:2.2rem;font-weight:800;letter-spacing:-.03em;line-height:1.1}
.t-title{font-size:1.25rem;font-weight:700;letter-spacing:-.02em}
.t-body{font-size:.95rem;font-weight:400;line-height:1.5}
.t-label{font-size:.72rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--ink3)}
.t-num{font-size:1.6rem;font-weight:800;letter-spacing:-.03em}
.t-sm{font-size:.8rem;color:var(--ink3)}

/* ─── LAYOUT ───────────────────────────────────────── */
.scroll{overflow-y:auto;-webkit-overflow-scrolling:touch;flex:1}
.scroll::-webkit-scrollbar{display:none}
.pad{padding:16px}
.pad-h{padding:0 16px}
.gap4{gap:4px}.gap8{gap:8px}.gap12{gap:12px}.gap16{gap:16px}
.row{display:flex;align-items:center}
.col{display:flex;flex-direction:column}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}

/* ─── CARDS ────────────────────────────────────────── */
.card{background:var(--white);border-radius:var(--r);box-shadow:var(--sh);overflow:hidden}
.card-sm{background:var(--white);border-radius:var(--r2);box-shadow:var(--sh)}

/* ─── BUTTONS ──────────────────────────────────────── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:none;border-radius:var(--r2);font-weight:700;cursor:pointer;transition:transform .12s,opacity .12s;-webkit-appearance:none}
.btn:active{transform:scale(.96);opacity:.85}
.btn-lg{padding:15px 24px;font-size:1rem;border-radius:var(--r)}
.btn-md{padding:11px 18px;font-size:.9rem}
.btn-sm{padding:7px 13px;font-size:.78rem;border-radius:var(--r3)}
.btn-blue{background:var(--blue);color:#fff}
.btn-green{background:var(--green);color:#fff}
.btn-red{background:var(--red);color:#fff}
.btn-orange{background:var(--orange);color:#fff}
.btn-ghost{background:transparent;color:var(--ink2);border:1.5px solid var(--line)}
.btn-paper{background:var(--paper);color:var(--ink)}
.btn-full{width:100%}

/* ─── PILL / BADGE ─────────────────────────────────── */
.pill{display:inline-flex;align-items:center;gap:5px;border-radius:20px;padding:4px 11px;font-size:.75rem;font-weight:700}
.pill-blue{background:var(--blue-bg);color:var(--blue)}
.pill-green{background:var(--green-bg);color:var(--green)}
.pill-orange{background:var(--orange-bg);color:var(--orange)}
.pill-purple{background:var(--purple-bg);color:var(--purple)}
.pill-red{background:var(--red-bg);color:var(--red)}
.pill-yellow{background:var(--yellow-bg);color:#B8860B}

/* ─── PROGRESS BAR ─────────────────────────────────── */
.prog-track{background:var(--line);border-radius:99px;overflow:hidden}
.prog-fill{height:100%;border-radius:99px;transition:width .4s ease}

/* ─── DIVIDER ──────────────────────────────────────── */
.div{height:1px;background:var(--line);margin:0 16px}

/* ─── TOAST ────────────────────────────────────────── */
#toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--ink);color:#fff;border-radius:var(--r2);padding:10px 18px;font-size:.84rem;font-weight:600;opacity:0;transition:all .25s;z-index:9999;white-space:nowrap;pointer-events:none;max-width:90vw;text-align:center}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ─── MODAL ────────────────────────────────────────── */
#moverlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:8000;display:none;align-items:flex-end;justify-content:center}
#moverlay.on{display:flex}
#msheet{background:var(--white);border-radius:24px 24px 0 0;padding:20px 20px 36px;width:100%;max-width:480px;box-shadow:0 -8px 40px rgba(0,0,0,.15)}
.mhandle{width:36px;height:4px;background:var(--line);border-radius:4px;margin:0 auto 18px}

/* ─── BOTTOM NAV ───────────────────────────────────── */
.bnav{position:fixed;bottom:0;left:0;right:0;background:var(--white);border-top:1px solid var(--line);display:flex;justify-content:space-around;padding:8px 0 max(8px,env(safe-area-inset-bottom));z-index:500}
.bni{display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;padding:4px 12px;border:none;background:none;color:var(--ink3);font-size:.62rem;font-weight:600;transition:color .15s;min-width:60px}
.bni.on{color:var(--blue)}
.bni .ico{font-size:1.35rem;line-height:1;transition:transform .15s}
.bni.on .ico{transform:scale(1.1)}

/* ─── TOP BAR ──────────────────────────────────────── */
.topbar{background:var(--white);border-bottom:1px solid var(--line);padding:12px 16px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.topbar-title{font-size:1.05rem;font-weight:700}

/* ─── STREAK FLAME ─────────────────────────────────── */
@keyframes flame{0%,100%{transform:scale(1) rotate(-2deg)}50%{transform:scale(1.08) rotate(2deg)}}
.flame{display:inline-block;animation:flame 1.2s ease-in-out infinite}

/* ─── XP BURST ─────────────────────────────────────── */
@keyframes xpburst{0%{opacity:1;transform:translateY(0) scale(1)}100%{opacity:0;transform:translateY(-60px) scale(1.4)}}
.xpburst{position:fixed;font-size:1.1rem;font-weight:800;color:var(--orange);pointer-events:none;animation:xpburst .8s ease forwards;z-index:9998}

/* ─── SHAKE ────────────────────────────────────────── */
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-8px)}40%{transform:translateX(8px)}60%{transform:translateX(-5px)}80%{transform:translateX(5px)}}
.shake{animation:shake .35s ease}

/* ─── GLOW ─────────────────────────────────────────── */
@keyframes glow{0%,100%{box-shadow:var(--sh)}50%{box-shadow:0 0 0 4px rgba(52,199,89,.25),var(--sh)}}
.glow{animation:glow .4s ease}

/* ─── BOUNCE ───────────────────────────────────────── */
@keyframes bounce{0%,100%{transform:scale(1)}40%{transform:scale(1.12)}70%{transform:scale(.95)}}
.bounce{animation:bounce .4s ease}

/* ─── COIN SPIN ────────────────────────────────────── */
@keyframes coinspin{0%{transform:rotateY(0)}100%{transform:rotateY(360deg)}}
.coinspin{animation:coinspin .6s ease}

/* ─── PROPERTY COLORS ──────────────────────────────── */
.prop-brown{background:#8B4513}
.prop-lblue{background:#87CEEB}
.prop-pink{background:#FF69B4}
.prop-orange{background:#FF8C00}
.prop-red{background:#DC143C}
.prop-yellow{background:#FFD700}
.prop-green{background:#228B22}
.prop-blue{background:#00008B}
.prop-station{background:#555}
.prop-utility{background:#888}

/* ─── ANSWER BUTTONS ───────────────────────────────── */
.ans-btn{width:100%;background:var(--white);border:2px solid var(--line);border-radius:var(--r2);padding:13px 16px;text-align:left;cursor:pointer;font-size:.92rem;font-weight:500;color:var(--ink);display:flex;align-items:center;gap:12px;transition:border-color .15s,background .15s;-webkit-appearance:none}
.ans-btn:active:not(:disabled){transform:scale(.98)}
.ans-btn .altr{width:30px;height:30px;border-radius:9px;background:var(--paper);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.78rem;color:var(--ink3);flex-shrink:0;transition:all .15s}
.ans-btn:hover:not(:disabled){border-color:var(--blue);background:var(--blue-bg)}
.ans-btn:hover:not(:disabled) .altr{background:var(--blue);color:#fff}
.ans-btn:disabled{cursor:default}
.ans-btn.correct{background:var(--green-bg);border-color:var(--green);color:#1a5c2a}
.ans-btn.correct .altr{background:var(--green);color:#fff}
.ans-btn.wrong{background:var(--red-bg);border-color:var(--red);color:#7a1a1a}
.ans-btn.wrong .altr{background:var(--red);color:#fff}
.ans-btn.dim{opacity:.3}

/* ─── TIMER BAR ────────────────────────────────────── */
.tbar-wrap{height:5px;background:var(--line);border-radius:5px;overflow:hidden}
.tbar{height:100%;border-radius:5px;transition:width linear}
.tbar.ok{background:var(--green)}.tbar.no{background:var(--red)}

/* ─── PROPERTY CARD ────────────────────────────────── */
.prop-card{background:var(--white);border-radius:var(--r);box-shadow:var(--sh);overflow:hidden;cursor:pointer;transition:transform .15s,box-shadow .15s;position:relative}
.prop-card:active{transform:scale(.97)}
.prop-card .prop-top{height:8px}
.prop-card .prop-body{padding:10px 12px 12px}
.prop-card .prop-name{font-size:.82rem;font-weight:700;line-height:1.2;margin-bottom:4px}
.prop-card .prop-price{font-size:.72rem;color:var(--ink3);font-weight:600}
.prop-card .prop-owner{position:absolute;top:10px;right:10px;width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:800;color:#fff}
.prop-card.owned{box-shadow:var(--sh2)}
.prop-card .prop-level{display:flex;gap:2px;margin-top:6px}
.prop-card .prop-level span{width:8px;height:8px;border-radius:2px;background:var(--line)}
.prop-card .prop-level span.filled{background:var(--orange)}

/* ─── PLAYER AVATAR ────────────────────────────────── */
.avatar{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:800;flex-shrink:0}

/* ─── LEADERBOARD ROW ──────────────────────────────── */
.lb-row{display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--white);border-radius:var(--r2);box-shadow:var(--sh)}
.lb-rank{width:28px;text-align:center;font-size:.85rem;font-weight:800;color:var(--ink3)}
.lb-rank.gold{color:#B8860B}.lb-rank.silver{color:#888}.lb-rank.bronze{color:#8B4513}

/* ─── IMPORT TEXTAREA ──────────────────────────────── */
.imp-ta{width:100%;min-height:180px;background:var(--paper);border:1.5px solid var(--line);border-radius:var(--r2);padding:12px;font-size:.86rem;font-family:monospace;color:var(--ink);line-height:1.6;resize:vertical;outline:none}
.imp-ta:focus{border-color:var(--blue);background:var(--white)}
.imp-ta::placeholder{color:var(--ink3)}
.form-inp{width:100%;background:var(--paper);border:1.5px solid var(--line);border-radius:var(--r2);padding:10px 13px;font-size:.9rem;color:var(--ink);outline:none}
.form-inp:focus{border-color:var(--blue);background:var(--white)}
select.form-inp option{background:var(--white)}

/* ─── NOTIFICATION DOT ─────────────────────────────── */
.notif-dot{width:8px;height:8px;background:var(--red);border-radius:50%;position:absolute;top:2px;right:2px}

/* ─── CONFETTI ─────────────────────────────────────── */
@keyframes conffall{0%{transform:translateY(-20px) rotate(0);opacity:1}100%{transform:translateY(100vh) rotate(720deg);opacity:0}}
.conf{position:fixed;width:8px;height:8px;border-radius:2px;pointer-events:none;animation:conffall linear forwards;z-index:9997}
</style>
</head>
<body>

<div id="toast"></div>

<!-- MODAL -->
<div id="moverlay">
  <div id="msheet">
    <div class="mhandle"></div>
    <div id="msheet-content"></div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════ -->
<!-- SCREEN: HOME ──────────────────────────────────── -->
<!-- ══════════════════════════════════════════════════ -->
<div class="screen on" id="s-home">
  <div class="scroll">
    <div class="pad col gap16" style="padding-bottom:90px">

      <!-- Header -->
      <div class="row" style="justify-content:space-between;padding-top:8px">
        <div>
          <div class="t-label">Dobrodošel nazaj 👋</div>
          <div class="t-title" id="h-name">Učenec</div>
        </div>
        <div class="row gap8">
          <div class="pill pill-orange"><span class="flame">🔥</span><span id="h-streak">0</span></div>
          <div class="pill pill-yellow">⚡ <span id="h-xp">0</span></div>
        </div>
      </div>

      <!-- Daily challenge banner -->
      <div id="daily-banner" style="background:linear-gradient(135deg,#007AFF,#5856D6);border-radius:var(--r);padding:18px;color:#fff;position:relative;overflow:hidden;cursor:pointer" onclick="goTo('s-quiz-list')">
        <div style="position:absolute;right:-12px;bottom:-12px;font-size:5rem;opacity:.15">🎯</div>
        <div class="t-label" style="color:rgba(255,255,255,.8);margin-bottom:6px">🔥 DNEVNI IZZIV</div>
        <div style="font-size:1.05rem;font-weight:700;margin-bottom:4px" id="daily-title">Začni nov kviz!</div>
        <div style="font-size:.82rem;opacity:.85;margin-bottom:14px" id="daily-sub">Ustvari kviz in osvoji XP</div>
        <div class="row gap8">
          <div style="background:rgba(255,255,255,.2);border-radius:20px;padding:4px 12px;font-size:.75rem;font-weight:700">⚡ +100 XP</div>
          <div style="background:rgba(255,255,255,.2);border-radius:20px;padding:4px 12px;font-size:.75rem;font-weight:700">🏠 +1 Posest</div>
        </div>
      </div>

      <!-- Stats row -->
      <div class="grid3">
        <div class="card-sm pad col gap4" style="padding:12px;text-align:center">
          <div class="t-num" style="color:var(--blue)" id="st-quizzes">0</div>
          <div class="t-label">Kvizov</div>
        </div>
        <div class="card-sm pad col gap4" style="padding:12px;text-align:center">
          <div class="t-num" style="color:var(--green)" id="st-coins">0</div>
          <div class="t-label">Kovancev</div>
        </div>
        <div class="card-sm pad col gap4" style="padding:12px;text-align:center">
          <div class="t-num" style="color:var(--orange)" id="st-props">0</div>
          <div class="t-label">Posesti</div>
        </div>
      </div>

      <!-- My properties preview -->
      <div>
        <div class="row" style="justify-content:space-between;margin-bottom:10px">
          <div class="t-title" style="font-size:1rem">🏠 Moje posesti</div>
          <button class="btn btn-sm btn-ghost" onclick="goTo('s-map')">Vse →</button>
        </div>
        <div id="home-props" class="grid2"></div>
      </div>

      <!-- Recent quizzes -->
      <div>
        <div class="row" style="justify-content:space-between;margin-bottom:10px">
          <div class="t-title" style="font-size:1rem">📚 Moji kvizi</div>
          <button class="btn btn-sm btn-ghost" onclick="goTo('s-quiz-list')">Vse →</button>
        </div>
        <div id="home-quizzes" class="col gap8"></div>
      </div>

      <!-- Achievements -->
      <div>
        <div class="t-title" style="font-size:1rem;margin-bottom:10px">🏆 Dosežki</div>
        <div class="card pad" style="padding:16px">
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px">
            <div id="ach-0" class="col gap4" style="align-items:center;opacity:.35">
              <div style="width:48px;height:48px;border-radius:14px;background:var(--yellow-bg);display:flex;align-items:center;justify-content:center;font-size:1.5rem">🌟</div>
              <div style="font-size:.62rem;font-weight:700;color:var(--ink3);text-align:center">Začetnik</div>
            </div>
            <div id="ach-1" class="col gap4" style="align-items:center;opacity:.35">
              <div style="width:48px;height:48px;border-radius:14px;background:var(--blue-bg);display:flex;align-items:center;justify-content:center;font-size:1.5rem">🧠</div>
              <div style="font-size:.62rem;font-weight:700;color:var(--ink3);text-align:center">Mislec</div>
            </div>
            <div id="ach-2" class="col gap4" style="align-items:center;opacity:.35">
              <div style="width:48px;height:48px;border-radius:14px;background:var(--orange-bg);display:flex;align-items:center;justify-content:center;font-size:1.5rem">🔥</div>
              <div style="font-size:.62rem;font-weight:700;color:var(--ink3);text-align:center">Serija 7</div>
            </div>
            <div id="ach-3" class="col gap4" style="align-items:center;opacity:.35">
              <div style="width:48px;height:48px;border-radius:14px;background:var(--green-bg);display:flex;align-items:center;justify-content:center;font-size:1.5rem">🏠</div>
              <div style="font-size:.62rem;font-weight:700;color:var(--ink3);text-align:center">Lastnik</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
  <div class="bnav">
    <button class="bni on" onclick="goTo('s-home')"><span class="ico">🏠</span>Domov</button>
    <button class="bni" onclick="goTo('s-map')"><span class="ico">🗺️</span>Mapa</button>
    <button class="bni" onclick="goTo('s-quiz-list')"><span class="ico">📚</span>Kvizi</button>
    <button class="bni" onclick="goTo('s-lb')"><span class="ico">🏆</span>Lestvica</button>
    <button class="bni" onclick="goTo('s-import')"><span class="ico">➕</span>Nov</button>
  </div>
</div>

<!-- ══════════════════════════════════════════════════ -->
<!-- SCREEN: MAP (MONOPOLY) ────────────────────────── -->
<!-- ══════════════════════════════════════════════════ -->
<div class="screen" id="s-map">
  <div class="topbar">
    <div>
      <div class="topbar-title">🗺️ Mapa posesti</div>
      <div class="t-sm">Kupi posesti z kovanci</div>
    </div>
    <div class="pill pill-yellow">🪙 <span id="map-coins">0</span></div>
  </div>
  <div class="scroll">
    <div class="pad col gap12" style="padding-bottom:90px">
      <div class="card-sm pad" style="padding:12px;background:var(--blue-bg);border:1px solid rgba(0,122,255,.15)">
        <div style="font-size:.82rem;color:var(--blue);font-weight:600">💡 Kako deluje?</div>
        <div style="font-size:.78rem;color:var(--ink2);margin-top:3px;line-height:1.5">Odgovarjaj pravilno → zasluži kovance → kupi posesti → nadgradi jih → poberi najemnino od prijateljev!</div>
      </div>
      <div id="map-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:10px"></div>
    </div>
  </div>
  <div class="bnav">
    <button class="bni" onclick="goTo('s-home')"><span class="ico">🏠</span>Domov</button>
    <button class="bni on" onclick="goTo('s-map')"><span class="ico">🗺️</span>Mapa</button>
    <button class="bni" onclick="goTo('s-quiz-list')"><span class="ico">📚</span>Kvizi</button>
    <button class="bni" onclick="goTo('s-lb')"><span class="ico">🏆</span>Lestvica</button>
    <button class="bni" onclick="goTo('s-import')"><span class="ico">➕</span>Nov</button>
  </div>
</div>

<!-- ══════════════════════════════════════════════════ -->
<!-- SCREEN: QUIZ LIST ─────────────────────────────── -->
<!-- ══════════════════════════════════════════════════ -->
<div class="screen" id="s-quiz-list">
  <div class="topbar">
    <div class="topbar-title">📚 Kvizi</div>
    <button class="btn btn-sm btn-blue" onclick="goTo('s-import')">➕ Nov</button>
  </div>
  <div class="scroll">
    <div class="pad col gap10" style="padding-bottom:90px">
      <div style="position:relative">
        <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--ink3)">🔍</span>
        <input class="form-inp" id="ql-search" placeholder="Išči kvize..." style="padding-left:36px" oninput="renderQL()">
      </div>
      <div id="ql-list" class="col gap8"></div>
    </div>
  </div>
  <div class="bnav">
    <button class="bni" onclick="goTo('s-home')"><span class="ico">🏠</span>Domov</button>
    <button class="bni" onclick="goTo('s-map')"><span class="ico">🗺️</span>Mapa</button>
    <button class="bni on" onclick="goTo('s-quiz-list')"><span class="ico">📚</span>Kvizi</button>
    <button class="bni" onclick="goTo('s-lb')"><span class="ico">🏆</span>Lestvica</button>
    <button class="bni" onclick="goTo('s-import')"><span class="ico">➕</span>Nov</button>
  </div>
</div>

<!-- ══════════════════════════════════════════════════ -->
<!-- SCREEN: LEADERBOARD ───────────────────────────── -->
<!-- ══════════════════════════════════════════════════ -->
<div class="screen" id="s-lb">
  <div class="topbar">
    <div class="topbar-title">🏆 Lestvica</div>
